[Unit]
Description=Offline Joe (MS4 voice demo)
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/offlinejoe
Environment=JOE_HARDWARE_YAML=/opt/offlinejoe/config/hardware.yaml
Environment=JOE_DATA_DIR=/home/pi/.offlinejoe
ExecStart=/usr/bin/env bash -lc 'joe run-voice'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
